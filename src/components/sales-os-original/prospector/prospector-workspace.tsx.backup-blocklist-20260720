"use client";

import {
  saveProspectedCompanyAction,
  searchCompaniesAction,
  type ProspectedCompany,
  type ProspectorActionResult,
  type SaveProspectResult,
} from "@/app/(sistema)/prospector/actions/prospector-actions";
import {
  AlertCircle,
  ArrowRight,
  Bot,
  Building2,
  CheckCircle2,
  CircleGauge,
  ExternalLink,
  Globe2,
  LoaderCircle,
  MapPin,
  MessageCircle,
  Search,
  Sparkles,
  Target,
  UserRound,
} from "lucide-react";
import Link from "next/link";
import {
  useActionState,
  useState,
} from "react";

const initialSearchState:
  ProspectorActionResult = {
    success: false,
    message: "",
    companies: [],
  };

const initialSaveState:
  SaveProspectResult = {
    success: false,
    message: "",
    leadId: null,
  };

function formatMoney(value: number) {
  return new Intl.NumberFormat(
    "pt-BR",
    {
      style: "currency",
      currency: "BRL",
      maximumFractionDigits: 0,
    }
  ).format(value);
}

function getTemperatureLabel(
  value: ProspectedCompany["temperature"]
) {
  const labels = {
    cold: "Frio",
    warm: "Morno",
    hot: "Quente",
  };

  return labels[value];
}

function getPriorityLabel(
  value: ProspectedCompany["priority"]
) {
  const labels = {
    low: "Baixa",
    medium: "Média",
    high: "Alta",
  };

  return labels[value];
}

function normalizeUrl(value: string) {
  if (
    value.startsWith("http://") ||
    value.startsWith("https://")
  ) {
    return value;
  }

  return `https://${value}`;
}

function SaveProspectButton({
  company,
}: {
  company: ProspectedCompany;
}) {
  const [
    state,
    action,
    isPending,
  ] = useActionState(
    saveProspectedCompanyAction,
    initialSaveState
  );

  if (
    state.success &&
    state.leadId
  ) {
    return (
      <Link
        className="primary-button"
        href={`/crm/${state.leadId}`}
      >
        <CheckCircle2 size={16} />
        Abrir no CRM
      </Link>
    );
  }

  return (
    <form action={action}>
      {Object.entries({
        company_name:
          company.company_name,
        segment: company.segment,
        website: company.website,
        instagram: company.instagram,
        phone: company.phone,
        whatsapp: company.whatsapp,
        email: company.email,
        city: company.city,
        state: company.state,
        decision_maker_name:
          company.decision_maker_name,
        decision_maker_role:
          company.decision_maker_role,
        marketing_diagnosis:
          company.marketing_diagnosis,
        commercial_opportunity:
          company.commercial_opportunity,
        recommended_approach:
          company.recommended_approach,
        estimated_value:
          String(
            company.estimated_value
          ),
        temperature:
          company.temperature,
        priority:
          company.priority,
        sources:
          company.sources.join("\n"),
      }).map(([name, value]) => (
        <input
          key={name}
          name={name}
          type="hidden"
          value={value}
        />
      ))}

      <button
        className="primary-button"
        disabled={isPending}
        type="submit"
      >
        {isPending ? (
          <>
            <LoaderCircle
              className="loading-icon"
              size={16}
            />
            Cadastrando...
          </>
        ) : (
          <>
            <Building2 size={16} />
            Cadastrar no CRM
          </>
        )}
      </button>

      {state.message && (
        <span
          className={
            state.success
              ? "prospector-save-success"
              : "prospector-save-error"
          }
        >
          {state.message}
        </span>
      )}
    </form>
  );
}

export function ProspectorWorkspace() {
  const [
    state,
    action,
    isPending,
  ] = useActionState(
    searchCompaniesAction,
    initialSearchState
  );

  const [
    expandedCompany,
    setExpandedCompany,
  ] = useState<string | null>(
    null
  );

  return (
    <>
      <section className="prospector-search-panel">
        <div className="prospector-search-heading">
          <div className="prospector-search-icon">
            <Search size={22} />
          </div>

          <div>
            <span className="panel-kicker">
              PESQUISA INTELIGENTE
            </span>

            <h3>
              Encontrar novas oportunidades
            </h3>

            <p>
              Pesquise por segmento, tipo de
              empresa ou oportunidade comercial.
            </p>
          </div>
        </div>

        <form
          action={action}
          className="prospector-search-form"
        >
          <label className="prospector-main-field">
            O que deseja encontrar?

            <div>
              <Search size={17} />

              <input
                name="search_query"
                placeholder="Ex.: construtoras com atuação em Maceió"
                required
                type="text"
              />
            </div>
          </label>

          <label>
            Cidade ou região

            <input
              defaultValue="Maceió, Alagoas"
              name="city"
              placeholder="Ex.: Maceió, Alagoas"
              type="text"
            />
          </label>

          <label>
            Quantidade

            <select
              defaultValue="8"
              name="amount"
            >
              <option value="3">
                3 empresas
              </option>

              <option value="5">
                5 empresas
              </option>

              <option value="8">
                8 empresas
              </option>

              <option value="10">
                10 empresas
              </option>

              <option value="12">
                12 empresas
              </option>
            </select>
          </label>

          <button
            className="primary-button prospector-search-button"
            disabled={isPending}
            type="submit"
          >
            {isPending ? (
              <>
                <LoaderCircle
                  className="loading-icon"
                  size={17}
                />

                Pesquisando na web...
              </>
            ) : (
              <>
                <Sparkles size={17} />
                Pesquisar empresas
              </>
            )}
          </button>
        </form>

        {state.message && (
          <div
            className={
              state.success
                ? "form-success prospector-message"
                : "form-error prospector-message"
            }
          >
            {state.success ? (
              <CheckCircle2 size={16} />
            ) : (
              <AlertCircle size={16} />
            )}

            {state.message}
          </div>
        )}
      </section>

      {isPending && (
        <section className="panel prospector-loading">
          <div className="prospector-loading-orb">
            <Bot size={27} />
          </div>

          <strong>
            Pesquisando empresas reais...
          </strong>

          <span>
            A IA está verificando sites,
            perfis públicos, contatos e sinais
            comerciais. Isso pode levar alguns
            segundos.
          </span>
        </section>
      )}

      {!isPending &&
        state.companies.length > 0 && (
          <section className="prospector-results">
            <div className="prospector-results-heading">
              <div>
                <span className="panel-kicker">
                  RESULTADOS
                </span>

                <h3>
                  Oportunidades encontradas
                </h3>
              </div>

              <span>
                Revise os dados antes de
                realizar qualquer contato.
              </span>
            </div>

            <div className="prospector-company-list">
              {state.companies.map(
                (company, index) => {
                  const isExpanded =
                    expandedCompany ===
                    company.company_name;

                  return (
                    <article
                      className="prospector-company-card"
                      key={`${company.company_name}-${index}`}
                    >
                      <div className="prospector-company-top">
                        <span className="prospector-company-position">
                          {index + 1}
                        </span>

                        <div className="prospector-company-avatar">
                          {company.company_name
                            .slice(0, 2)
                            .toUpperCase()}
                        </div>

                        <div className="prospector-company-identity">
                          <strong>
                            {
                              company.company_name
                            }
                          </strong>

                          <span>
                            {company.segment ||
                              "Segmento não identificado"}
                          </span>

                          {(company.city ||
                            company.state) && (
                            <small>
                              <MapPin
                                size={12}
                              />

                              {[
                                company.city,
                                company.state,
                              ]
                                .filter(Boolean)
                                .join(" - ")}
                            </small>
                          )}
                        </div>

                        <div className="prospector-company-score">
                          <div>
                            <CircleGauge
                              size={17}
                            />

                            <span>
                              Score
                            </span>

                            <strong>
                              {
                                company.prospecting_score
                              }
                            </strong>
                          </div>

                          <div className="prospector-score-track">
                            <i
                              style={{
                                width: `${company.prospecting_score}%`,
                              }}
                            />
                          </div>
                        </div>

                        <div className="prospector-company-badges">
                          <span
                            className={`temperature-badge ${company.temperature}`}
                          >
                            {getTemperatureLabel(
                              company.temperature
                            )}
                          </span>

                          <span
                            className={`lead-priority ${company.priority}`}
                          >
                            Prioridade{" "}
                            {getPriorityLabel(
                              company.priority
                            )}
                          </span>
                        </div>

                        <div className="prospector-company-value">
                          <span>
                            Valor sugerido
                          </span>

                          <strong>
                            {formatMoney(
                              company.estimated_value
                            )}
                          </strong>
                        </div>
                      </div>

                      <div className="prospector-company-summary">
                        <div>
                          <Target size={16} />

                          <p>
                            {
                              company.commercial_opportunity
                            }
                          </p>
                        </div>
                      </div>

                      <div className="prospector-company-actions">
                        <button
                          className="secondary-button prospector-site-button"
                          onClick={() =>
                            setExpandedCompany(
                              isExpanded
                                ? null
                                : company.company_name
                            )
                          }
                          type="button"
                        >
                          {isExpanded
                            ? "Ocultar detalhes"
                            : "Ver detalhes"}

                          <ArrowRight
                            size={15}
                          />
                        </button>

                        {company.website && (
                          <a
                            className="secondary-button prospector-whatsapp-button"
                            href={normalizeUrl(
                              company.website
                            )}
                            rel="noreferrer"
                            target="_blank"
                          >
                            <Globe2
                              size={15}
                            />
                            Site
                          </a>
                        )}

                        {company.whatsapp && (
                          <a
                            className="secondary-button"
                            href={`https://wa.me/${company.whatsapp.replace(/\D/g, "")}`}
                            rel="noreferrer"
                            target="_blank"
                          >
                            <MessageCircle
                              size={15}
                            />
                            WhatsApp
                          </a>
                        )}

                        <SaveProspectButton
                          company={company}
                        />
                      </div>

                      {isExpanded && (
                        <div className="prospector-details">
                          <article>
                            <span>
                              DIAGNÓSTICO
                            </span>

                            <strong>
                              Marketing atual
                            </strong>

                            <p>
                              {
                                company.marketing_diagnosis
                              }
                            </p>
                          </article>

                          <article>
                            <span>
                              ABORDAGEM
                            </span>

                            <strong>
                              Primeiro contato
                            </strong>

                            <p>
                              {
                                company.recommended_approach
                              }
                            </p>
                          </article>

                          <article>
                            <span>
                              DECISOR
                            </span>

                            <strong>
                              {company.decision_maker_name ||
                                "Não identificado"}
                            </strong>

                            <p>
                              {company.decision_maker_role ||
                                "Cargo não encontrado"}
                            </p>
                          </article>

                          <article>
                            <span>
                              CONTATOS
                            </span>

                            <strong>
                              {company.phone ||
                                company.whatsapp ||
                                company.email ||
                                "Não encontrados"}
                            </strong>

                            <p>
                              {company.email}
                            </p>
                          </article>

                          <article className="prospector-sources">
                            <span>
                              FONTES PÚBLICAS
                            </span>

                            <strong>
                              Verificação
                            </strong>

                            {company.sources.length >
                            0 ? (
                              <div>
                                {company.sources.map(
                                  (
                                    source,
                                    sourceIndex
                                  ) => (
                                    <a
                                      href={normalizeUrl(
                                        source
                                      )}
                                      key={`${source}-${sourceIndex}`}
                                      rel="noreferrer"
                                      target="_blank"
                                    >
                                      <ExternalLink
                                        size={13}
                                      />

                                      Fonte{" "}
                                      {sourceIndex +
                                        1}
                                    </a>
                                  )
                                )}
                              </div>
                            ) : (
                              <p>
                                Nenhuma URL foi
                                informada pela
                                pesquisa.
                              </p>
                            )}
                          </article>
                        </div>
                      )}
                    </article>
                  );
                }
              )}
            </div>
          </section>
        )}

      {!isPending &&
        state.companies.length === 0 &&
        !state.message && (
          <section className="panel prospector-empty">
            <div className="prospector-empty-icon">
              <Bot size={28} />
            </div>

            <strong>
              Comece uma nova pesquisa
            </strong>

            <span>
              Exemplos: hotéis em expansão,
              clínicas com presença digital
              fraca ou construtoras em Maceió.
            </span>
          </section>
        )}
    </>
  );
}