"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import {
  BarChart3,
  Bot,
  Building2,
  CalendarDays,
  ChevronLeft,
  LayoutDashboard,
  SearchCheck,
  Settings,
  Sparkles,
} from "lucide-react";
import { useState } from "react";

type NavigationItem = {
  label: string;
  href: string;
  icon: typeof LayoutDashboard;
  disabled?: boolean;
};

const navigation: NavigationItem[] = [
  {
    label: "Dashboard",
    href: "/dashboard",
    icon: LayoutDashboard,
  },
  {
    label: "CRM",
    href: "/crm",
    icon: Building2,
  },
  {
    label: "Agenda",
    href: "/agenda",
    icon: CalendarDays,
  },
  {
    label: "IA Comercial",
    href: "/assistente",
    icon: Bot,
  },
  {
    label: "Prospector IA",
    href: "/prospector",
    icon: SearchCheck,
  },
  {
    label: "Relatórios",
    href: "/relatorios",
    icon: BarChart3,
  },
];

export function Sidebar() {
  const pathname = usePathname();
  const [collapsed, setCollapsed] = useState(false);

  return (
    <aside className={`sidebar ${collapsed ? "sidebar-collapsed" : ""}`}>
      <div className="sidebar-brand">
  <div className="brand-background"></div>

  <div className="brand-logo-wrapper">

    <div className="brand-logo">

      <img
        src="/level-up-logo-dark.png"
        alt="Level UP"
        className="brand-image"
      />

    </div>

    <div className="brand-glow"></div>

  </div>

</div>

<nav className="sidebar-navigation">
        <p className="navigation-label">
          {!collapsed ? "COMERCIAL" : "•••"}
        </p>

        {navigation.map((item) => {
          const Icon = item.icon;
          const active = pathname === item.href;

          if (item.disabled) {
            return (
              <div
                className="navigation-item navigation-disabled"
                key={item.label}
                title={`${item.label} — em breve`}
              >
                <Icon size={19} />
                {!collapsed && (
                  <>
                    <span>{item.label}</span>
                    <small>Em breve</small>
                  </>
                )}
              </div>
            );
          }

          return (
            <Link
              className={`navigation-item ${active ? "navigation-active" : ""}`}
              href={item.href}
              key={item.href}
              title={collapsed ? item.label : undefined}
            >
              <Icon size={19} />
              {!collapsed && <span>{item.label}</span>}
            </Link>
          );
        })}
      </nav>

      <div className="sidebar-bottom">
        <Link
          className={`navigation-item ${
            pathname === "/configuracoes" ? "navigation-active" : ""
          }`}
          href="/configuracoes"
          title={collapsed ? "Configurações" : undefined}
        >
          <Settings size={19} />
          {!collapsed && <span>Configurações</span>}
        </Link>

        <button
          aria-label={collapsed ? "Expandir menu" : "Recolher menu"}
          className="collapse-button"
          onClick={() => setCollapsed((current) => !current)}
          type="button"
        >
          <ChevronLeft
            className={collapsed ? "collapse-icon-rotated" : ""}
            size={18}
          />

          {!collapsed && <span>Recolher menu</span>}
        </button>
      </div>
    </aside>
  );
}


