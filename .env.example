# ============================================================
# APROVUP - VARIAVEIS DE AMBIENTE
# ============================================================
#
# Este arquivo contem SOMENTE nomes de variaveis.
# Nunca coloque chaves reais, senhas ou secrets neste arquivo.
#
# Em producao, configure os valores diretamente
# no painel da hospedagem.
# ============================================================


# ============================================================
# CORE / BANCO PRINCIPAL
# OBRIGATORIAS
# ============================================================

DATABASE_URL=

# URL publica final da aplicacao.
# Exemplo:
# https://app.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# IDs autorizados para a Central administrativa.
APROVUP_COMMANDER_USER_IDS=

# Secret interno do AprovUp.
# Use um valor longo, aleatorio e exclusivo.
APROVUP_ACCESS_SECRET=


# ============================================================
# SUPABASE - APROVUP / STORAGE
# OBRIGATORIAS
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=

NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor.
# Nunca usar NEXT_PUBLIC_ neste secret.
SUPABASE_SECRET_KEY=


# ============================================================
# SUPABASE - CRM
# OBRIGATORIAS PARA O CRM
# ============================================================

NEXT_PUBLIC_CRM_SUPABASE_URL=

NEXT_PUBLIC_CRM_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor.
# Usada nas operacoes administrativas do CRM.
CRM_SUPABASE_SECRET_KEY=


# ============================================================
# OPENAI
# NECESSARIAS SE IA / PROSPECTOR FOREM UTILIZADOS
# ============================================================

OPENAI_API_KEY=

OPENAI_MODEL=


# ============================================================
# GOOGLE CALENDAR
# OPCIONAIS - SOMENTE SE A INTEGRACAO FOR UTILIZADA
# ============================================================

GOOGLE_CALENDAR_ID=

GOOGLE_SERVICE_ACCOUNT_EMAIL=

GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=


# ============================================================
# COMERCIAL / SITE
# OPCIONAL
# ============================================================

NEXT_PUBLIC_APROVUP_WHATSAPP=


# ============================================================
# ALIASES / FALLBACKS
# NAO CADASTRAR EM PRODUCAO SE AS VARIAVEIS ACIMA EXISTIREM
# ============================================================
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY
#   Fallback legado para NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
#
# SUPABASE_SERVICE_ROLE_KEY
#   Fallback legado para SUPABASE_SECRET_KEY.
#
# NODE_ENV
#   Normalmente definido automaticamente pela hospedagem.
#
# PORT
#   Normalmente definido automaticamente pela hospedagem.
#
# ============================================================

# ============================================================
# META / INSTAGRAM
# ============================================================

META_APP_ID=

# SOMENTE SERVIDOR
META_APP_SECRET=

META_GRAPH_VERSION=v26.0

# Opcional. Necessario se usar uma Configuration do
# Facebook Login for Business.
META_FACEBOOK_LOGIN_CONFIG_ID=

# Exemplo local:
# http://localhost:3000/api/integrations/instagram/callback
META_INSTAGRAM_REDIRECT_URI=

# Chave privada para criptografar tokens Meta.
# Nunca usar NEXT_PUBLIC_.
META_TOKEN_ENCRYPTION_KEY=
