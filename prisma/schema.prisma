generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Nota: estamos usando campos String para representar status, perfis e categorias no cÃ³digo.

model Agency {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  status String @default("ACTIVE")

  users   User[]
  clients Client[]

  designKanbanColumns      DesignKanbanColumn[]
  filmmakerKanbanColumns   FilmmakerKanbanColumn[]
  googleCalendarConnection GoogleCalendarConnection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GoogleCalendarConnection {
  id String @id @default(cuid())

  agencyId String @unique
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  googleAccountEmail    String?
  calendarId            String  @default("primary")
  encryptedRefreshToken String

  connectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  password       String?
  role           String    @default("SOCIAL_MEDIA")
  status         String    @default("PENDENTE")
  approvedAt     DateTime?
  approvedByName String?

  // Permissoes personalizadas do usuario.
  // Quando null, o sistema usa as permissoes padrao do cargo.
  permissions Json?

  // Convite criado pelo administrador.
  inviteToken     String?   @unique
  inviteExpiresAt DateTime?

  // Redefinicao de senha gerada exclusivamente pelo diretor.
  // O token original nunca fica armazenado no banco.
  resetPasswordTokenHash String?   @unique
  resetPasswordExpiresAt DateTime?
  agencyId               String?
  agency                 Agency?   @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

model Client {
  id                  String  @id @default(cuid())
  name                String
  segment             String?
  internalResponsible String?
  postingFrequency    String?
  monthlyContentGoal  Int     @default(0)
  toneOfVoice         String?
  contractedServices  String?
  usefulLinks         String?
  databaseLink        String?
  driveLink           String?
  logoLink            String?
  strategicNotes      String?
  logoUrl             String?
  brandColor          String?
  clientBriefing      String?
  personaNotes        String?

  contents                 Content[]
  personas                 ClientPersona[]
  diagnoses                ClientProfileDiagnosis[]
  monthlyApprovals         MonthlyApproval[]
  instagramConnection      InstagramConnection?
  instagramMetricSnapshots InstagramMetricSnapshot[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  cnpj                String?
  legalName           String?
  mainContact         String?
  contactPhone        String?
  contactEmail        String?
  companyAddress      String?
  businessDescription String?
  targetAudience      String?
  brandDifferentials  String?
  marketingGoals      String?
  competitors         String?
  benchmarkNotes      String?
  contentPillars      String?
  contentRestrictions String?

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  @@index([agencyId])
}

model ClientPersona {
  id                 String  @id @default(cuid())
  name               String
  ageRange           String?
  location           String?
  profession         String?
  painPoints         String?
  desires            String?
  objections         String?
  realPhrases        String?
  contentPreferences String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClientProfileDiagnosis {
  id String @id @default(cuid())

  instagramUrl String?
  teamNotes    String?

  profilePrintUrl    String?
  insightsPrintUrl   String?
  highlightsPrintUrl String?

  bioAnalysis              String?
  profilePhotoAnalysis     String?
  visualIdentityAnalysis   String?
  highlightsAnalysis       String?
  postingFrequencyAnalysis String?
  offerClarityAnalysis     String?
  strengths                String?
  improvementPoints        String?
  actionPlan               String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Content {
  id            String    @id @default(cuid())
  title         String
  objective     String?
  format        String?
  platform      String?
  plannedDate   DateTime?
  responsible   String?
  area          String    @default("GERAL")
  priority      String    @default("MEDIA")
  caption       String?
  artText       String?
  script        String?
  briefing      String?
  fileLinks     String?
  coverImageUrl String?
  status        String    @default("IDEIA")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  tasks                Task[]
  comments             Comment[]
  approvals            Approval[]
  instagramPublication InstagramPublication?
  instagramMediaAssets InstagramMediaAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finalMediaUrl   String?
  finalCoverUrl   String?
  finalMediaType  String?
  finalUploadedAt DateTime?
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("A_FAZER")
  priority    String    @default("MEDIA")
  dueDate     DateTime?
  responsible String?

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Comment {
  id         String  @id @default(cuid())
  authorName String?
  authorRole String?
  message    String

  // Audio opcional anexado ao comentario.
  audioUrl        String?
  audioMimeType   String?
  audioDurationMs Int?

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Approval {
  id            String  @id @default(cuid())
  token         String  @unique
  status        String  @default("PENDENTE")
  clientComment String?

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MonthlyApproval {
  id     String @id @default(cuid())
  token  String @unique
  month  Int
  year   Int
  status String @default("PENDENTE")

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, month, year])
}

model InstagramMediaAsset {
  id String @id @default(cuid())

  contentId String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  url      String
  mimeType String
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contentId, position])
  @@index([contentId])
}

model InstagramPublication {
  id String @id @default(cuid())

  contentId String  @unique
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  // Conta que sera usada na publicacao.
  instagramUserId   String?
  instagramUsername String?

  // Copia dos dados no momento da preparacao.
  caption   String?
  mediaUrl  String?
  coverUrl  String?
  mediaType String?

  // PRONTO | AGENDADO | PUBLICANDO | PUBLICADO | ERRO
  status String @default("PRONTO")

  scheduledFor DateTime?
  publishedAt  DateTime?

  // IDs devolvidos pela Meta.
  metaContainerId String?
  metaMediaId     String?
  permalink       String?

  attemptCount  Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([scheduledFor])
  @@index([instagramUserId])
}

model InstagramConnection {
  id String @id @default(cuid())

  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  instagramUserId String  @unique
  username        String?
  displayName     String?

  facebookPageId   String
  facebookPageName String?

  pageAccessTokenEncrypted String
  userAccessTokenEncrypted String?

  tokenExpiresAt DateTime?
  scopes         String?

  status String @default("ATIVO")

  connectedByUserId String?
  connectedAt       DateTime  @default(now())
  lastSyncAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([instagramUserId])
  @@index([facebookPageId])
}

model InstagramMetricSnapshot {
  id String @id @default(cuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  instagramUserId String

  dateKey String

  followersCount Int?
  reach          Int?
  views          Int?
  interactions   Int?

  capturedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, dateKey])
  @@index([instagramUserId, dateKey])
  @@index([dateKey])
}

model MetaOAuthSession {
  id String @id

  clientId String
  userId   String

  encryptedPayload String?

  expiresAt DateTime

  createdAt DateTime @default(now())

  @@index([clientId])
  @@index([userId])
  @@index([expiresAt])
}

model PromptTemplate {
  id        String   @id @default(cuid())
  title     String
  category  String?
  segment   String?
  prompt    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HistoryLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  description String
  authorName  String
  createdAt   DateTime @default(now())
}

model DesignKanbanColumn {
  id        String  @id @default(cuid())
  title     String
  statusKey String
  order     Int     @default(0)
  isActive  Boolean @default(true)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, statusKey])
  @@index([agencyId])
}

model FilmmakerKanbanColumn {
  id        String  @id @default(cuid())
  title     String
  statusKey String
  order     Int     @default(0)
  isActive  Boolean @default(true)

  agencyId String?
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, statusKey])
  @@index([agencyId])
}

model CaptureSchedule {
  id          String   @id @default(cuid())
  clientId    String
  contentId   String?
  clientName  String
  contentName String?
  scheduledAt DateTime
  dateKey     String
  location    String?
  notes       String?
  status      String   @default("AGENDADO")
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CaptureDateSuggestion {
  id            String   @id @default(cuid())
  clientId      String
  approvalToken String?
  dateKey       String
  time          String   @default("09:00")
  label         String?
  isActive      Boolean  @default(true)
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AprovUpLead {
  id          String   @id @default(cuid())
  name        String
  agency      String
  whatsapp    String
  clientCount String?
  biggestPain String?
  source      String   @default("site")
  status      String   @default("NOVO")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SaasPlanStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum SaasBillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
}

enum SaasSubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum SaasPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum SaasCouponStatus {
  ACTIVE
  PAUSED
  EXPIRED
}

enum SaasDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model SaasPlan {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String?
  status       SaasPlanStatus   @default(ACTIVE)
  billingCycle SaasBillingCycle @default(MONTHLY)

  priceCents    Int @default(0)
  setupFeeCents Int @default(0)

  maxClients Int @default(10)
  maxUsers   Int @default(3)

  canUseAi            Boolean @default(false)
  canUseCrm           Boolean @default(false)
  canUseSocialPosting Boolean @default(false)
  canUseReports       Boolean @default(false)

  monthlyAiLimitCents Int @default(0)

  sortOrder Int     @default(0)
  isPublic  Boolean @default(true)

  subscriptions SaasSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaasSubscription {
  id String @id @default(cuid())

  ownerUserId String
  ownerEmail  String?
  agencyName  String?

  planId String
  plan   SaasPlan @relation(fields: [planId], references: [id])

  status SaasSubscriptionStatus @default(ACTIVE)

  priceCents          Int @default(0)
  monthlyAiLimitCents Int @default(0)

  canUseAi            Boolean @default(false)
  canUseCrm           Boolean @default(false)
  canUseSocialPosting Boolean @default(false)
  canUseReports       Boolean @default(false)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  trialEndsAt        DateTime?
  canceledAt         DateTime?

  notes String?

  payments SaasPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId])
  @@index([planId])
  @@index([status])
}

model SaasPayment {
  id String @id @default(cuid())

  subscriptionId String?
  subscription   SaasSubscription? @relation(fields: [subscriptionId], references: [id])

  ownerUserId String?
  ownerEmail  String?
  agencyName  String?

  amountCents Int               @default(0)
  currency    String            @default("BRL")
  status      SaasPaymentStatus @default(PENDING)

  dueDate    DateTime?
  paidAt     DateTime?
  canceledAt DateTime?

  method            String?
  externalReference String?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([subscriptionId])
  @@index([ownerUserId])
  @@index([status])
  @@index([dueDate])
}

model SaasCoupon {
  id String @id @default(cuid())

  code        String           @unique
  description String?
  status      SaasCouponStatus @default(ACTIVE)

  discountType    SaasDiscountType @default(PERCENTAGE)
  discountPercent Int?
  discountCents   Int?

  appliesToPlanSlug String?

  maxUses   Int?
  usedCount Int  @default(0)

  validFrom  DateTime?
  validUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([appliesToPlanSlug])
}
